# =============================================================
# KonverPro API — Production Environment
# Copy this file ke .env dan isi nilai yang benar sebelum deploy
# =============================================================

APP_ENV=production
APP_DEBUG=false

# Wajib: set ke true karena production pakai HTTPS
SESSION_SECURE_COOKIE=true

# Domain untuk session cookie (pakai titik di depan untuk subdomain)
SESSION_DOMAIN=.unsia.ac.id

# Ganti dengan domain frontend production (Next.js)
CORS_ALLOWED_ORIGINS=https://DOMAIN_FRONTEND_PRODUCTION

# Cache: gunakan file (lebih cepat dari database di production)
CACHE_STORE=file

# Queue tetap database (worker harus dijalankan via supervisor)
QUEUE_CONNECTION=database
